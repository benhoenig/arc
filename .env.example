# ARC environment variables
# Copy to `.env.local` and fill in real values.
# Validated at boot by src/lib/env.ts — missing/malformed vars crash the app
# with a clear error. Keep this file in sync with the zod schema there.

# Public app URL — the canonical origin the app serves from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon — Postgres + Neon Auth (ap-southeast-1). See db/README.md + docs/TECH_STACK.md.
#   • DATABASE_URL:          pooled (-pooler) connection, used by Prisma/pg at runtime.
#   • DATABASE_URL_UNPOOLED: direct connection, used for migrations / psql / scripts.
#
# SSL: use sslmode=verify-full so the server cert is actually verified.
#   - Node's `pg` (DATABASE_URL) verifies against its bundled CA roots — no extra config.
#   - libpq/psql (DATABASE_URL_UNPOOLED) needs an explicit CA bundle. On libpq >= 16 use
#     `sslrootcert=system`; on older psql (e.g. Homebrew 14) point at the OS bundle,
#     `sslrootcert=/etc/ssl/cert.pem` on macOS. Values with `&` MUST be quoted.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full&sslrootcert=/etc/ssl/cert.pem"

# Neon Auth (managed Better Auth). Cookie secret must be >= 32 chars.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Vercel Blob — private store for property thumbnails + receipts.
BLOB_READ_WRITE_TOKEN=

# LINE Notify — v1 notification channel. v2 migrates to LINE Messaging API.
LINE_NOTIFY_CLIENT_ID=
LINE_NOTIFY_CLIENT_SECRET=

# Trigger.dev — background jobs per docs/TECH_STACK.md §10.1.
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# Sentry — optional; leave blank to disable. Enable in v1.5+ per docs/TECH_STACK.md §13.
SENTRY_DSN=
